{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "task-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "triggers": {
    "crons": ["* * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "task-sync-db",
      "database_id": "daa51ec9-e4d0-4d59-906b-e0968f1ffa97"
    }
  ]
}